generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  googleSub    String?   @unique
  name         String?
  passwordHash String?
  role         String    @default("USER")
  isActive     Boolean   @default(false)
  monthlySalaryCents Int?
  salaryCurrency String @default("ARS")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  driverLocation DriverVehicleLocation?
  driverLocationSamples DriverLocationSample[]
  accountingEntries AccountingEntry[]
  chapelcoDuties ChapelcoVehicleDuty[]
  airportDuties AirportVehicleAssignment[]
  specialTripAssignments SpecialTripAssignment[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model TravelRoute {
  id          String     @id @default(cuid())
  slug        String     @unique
  from        String
  to          String
  via         String
  durationMin Int
  priceCents  Int
  currency    String     @default("ARS")
  category    String
  description String
  featured    Boolean    @default(false)
  isActive    Boolean    @default(true)
  bookingMode String     @default("SEATED")
  specialType String?
  serviceStartDate DateTime?
  serviceEndDate   DateTime?
  stops       Json
  schedules   Schedule[]
  directReservations Reservation[]
  chapelcoOperationDays ChapelcoOperationDay[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Vehicle {
  id           String     @id @default(cuid())
  name         String
  brand        String     @default("Araucana")
  model        String     @default("Operativo")
  licensePlate String?
  templateKey  String?
  layoutMarkers Json       @default("[]")
  isActive     Boolean    @default(true)
  // ── Ficha de la unidad (planilla de flota del cliente) ──────────────────────
  /** Número de interno con el que la empresa identifica la unidad ("1910", "243", "152"). */
  internalNumber String?
  /** Titular registral: LA ARAUCANA VIAJES SRL, TROMPUL S.R.L., PRIETO JUAN CARLOS. */
  owner        String?
  year         Int?
  acquiredAt   DateTime?
  /** Vencimiento de la revisión técnica (VTV). */
  technicalInspectionDueAt DateTime?
  /** Vencimiento del RTO nacional. */
  rtoDueAt     DateTime?
  insurer      String?
  policyDueAt  DateTime?
  /**
   * Habilita la unidad para "transporte público" (los tramos que vende la web).
   * En la planilla del cliente son las aseguradas por **Prot Mut**: los buses grandes.
   */
  publicTransport Boolean @default(false)
  /** CAMIONETA · BUS · UTILITARIO (los utilitarios no se asignan a salidas). */
  kind         String     @default("CAMIONETA")
  notes        String?
  seats        Seat[]
  schedules    Schedule[]
  driverLocations DriverVehicleLocation[]
  driverLocationSamples DriverLocationSample[]
  accountingEntries AccountingEntry[]
  chapelcoDuties ChapelcoVehicleDuty[]
  airportAssignments AirportVehicleAssignment[]
  specialTripAssignments SpecialTripAssignment[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt @default(now())

  @@index([internalNumber])
  @@index([licensePlate])
}

model AccountingEntry {
  id           String   @id @default(cuid())
  category     String
  amountCents  Int
  currency     String   @default("ARS")
  occurredAt   DateTime
  vehicleId    String?
  vehicle      Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  salaryPeriod String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([occurredAt])
  @@index([category])
  @@index([vehicleId])
  @@index([userId])
  @@index([salaryPeriod])
}

model DriverVehicleLocation {
  id         String   @id @default(cuid())
  driverId   String   @unique
  driver     User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  latitude   Float
  longitude  Float
  accuracy   Float?
  heading    Float?
  speed      Float?
  altitude   Float?
  altitudeAccuracy Float?
  batteryLevel Float?
  batteryCharging Boolean?
  clientNetworkType String?
  distanceFromPreviousMeters Float?
  secondsFromPrevious Float?
  reportedSpeedKmh Float?
  inferredSpeedKmh Float?
  isStopped Boolean @default(false)
  stoppedDurationSeconds Float @default(0)
  stopStartedAt DateTime?
  recordedAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([vehicleId])
  @@index([recordedAt])
}

model DriverLocationSample {
  id         String   @id @default(cuid())
  driverId   String
  driver     User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  latitude   Float
  longitude  Float
  accuracy   Float?
  heading    Float?
  speed      Float?
  altitude   Float?
  altitudeAccuracy Float?
  batteryLevel Float?
  batteryCharging Boolean?
  clientNetworkType String?
  distanceFromPreviousMeters Float?
  secondsFromPrevious Float?
  reportedSpeedKmh Float?
  inferredSpeedKmh Float?
  isStopped Boolean @default(false)
  stoppedDurationSeconds Float @default(0)
  stopStartedAt DateTime?
  recordedAt DateTime
  createdAt  DateTime @default(now())

  @@index([driverId, recordedAt])
  @@index([vehicleId, recordedAt])
  @@index([isStopped])
}

model Flight {
  id            String        @id @default(cuid())
  number        String
  airline       String?
  origin        String
  destination   String        @default("Aeropuerto Chapelco (CPC)")
  direction     String        @default("ARRIVAL")
  scheduledAt   DateTime
  estimatedAt   DateTime?
  pickupStartOverrideAt DateTime?
  actualAt      DateTime?
  status        String        @default("SCHEDULED")
  passengers    Int?
  source        String        @default("MANUAL")
  externalId    String?
  lastCheckedAt DateTime?
  notes         String?
  createdBy     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  events        FlightEvent[]
  reservations  AirportReservationDetails[]
  assignments   AirportVehicleAssignment[]

  @@unique([number, scheduledAt, direction])
  @@index([scheduledAt])
  @@index([status])
}

model FlightEvent {
  id         String    @id @default(cuid())
  flightId   String
  flight     Flight    @relation(fields: [flightId], references: [id], onDelete: Cascade)
  kind       String
  fromValue  String?
  toValue    String?
  detectedAt DateTime  @default(now())
  notifiedAt DateTime?

  @@index([flightId, detectedAt])
}

model AirportReservationDetails {
  id            String      @id @default(cuid())
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  flightNumber  String
  flightId      String?
  flight        Flight?     @relation(fields: [flightId], references: [id], onDelete: SetNull)
  direction     String
  serviceDate   DateTime
  pickupName    String?
  pickupAddress String?
  pickupLatitude Float?
  pickupLongitude Float?
  pickupNotes   String?
  halfFareCount Int         @default(0)
  /// Bultos de equipaje deportivo y precio unitario vigente al reservar.
  sportsLuggageCount     Int @default(0)
  sportsLuggageUnitCents Int @default(0)
  /// Recargo por zona (segundo límite del mapa) cobrado al reservar.
  zoneExtraCents         Int @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([serviceDate, direction])
  @@index([flightNumber])
}

model AirportVehicleAssignment {
  id        String   @id @default(cuid())
  flightId  String
  flight    Flight   @relation(fields: [flightId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId  String?
  driver    User?    @relation(fields: [driverId], references: [id], onDelete: SetNull)
  notes     String?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([flightId, vehicleId])
  @@index([flightId])
}

model Seat {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  number    String
  row       Int
  column    Int
  createdAt DateTime @default(now())
  reservations Reservation[]

  @@unique([vehicleId, number])
}

model Schedule {
  id           String        @id @default(cuid())
  routeId      String
  route        TravelRoute   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  vehicleId    String
  vehicle      Vehicle       @relation(fields: [vehicleId], references: [id])
  departureAt  DateTime
  arrivalAt    DateTime
  status       String        @default("OPEN")
  reservations Reservation[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([routeId, departureAt])
}

model Passenger {
  id           String        @id @default(cuid())
  firstName    String
  lastName     String
  email        String
  phone        String
  documentType String
  documentId   String
  nationality  String?
  reservations Reservation[]
  excursionBookings ExcursionBooking[]
  createdAt    DateTime      @default(now())
}

/// Contador de pedidos por IP y ventana de tiempo: el freno contra ráfagas de reservas.
model RateLimitHit {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}

model Reservation {
  id          String     @id @default(cuid())
  code        String     @unique
  // Código corto para dictar, imprimir y buscar en el panel (issue #75). No es una capability:
  // la reserva se abre sólo con `code`, y este código lo resuelve el buscador con sesión de staff.
  shortCode   String     @unique
  scheduleId  String?
  // Restrict a propósito: la base real ya lo tiene así y no queremos que borrar una salida
  // con reservas deje huérfanas a las reservas (el esquema declaraba SetNull por deriva vieja).
  schedule    Schedule?  @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  routeId     String?
  route       TravelRoute? @relation(fields: [routeId], references: [id], onDelete: SetNull)
  passengerId String
  passenger   Passenger  @relation(fields: [passengerId], references: [id])
  seatId      String?
  seat        Seat?      @relation(fields: [seatId], references: [id], onDelete: Restrict)
  seatNumber  String?
  dropoffStop String?
  passengerCount Int     @default(1)
  // Tarifas por edad (issue #33): los pasajeros vienen dentro de passengerCount, que es el total
  // que ocupa lugar. `halfFareCount` son los menores de 4 a 8 años y `freeFareCount` los menores de 4.
  halfFareCount Int      @default(0)
  freeFareCount Int      @default(0)
  bookingMode String     @default("SEATED")
  status      String     @default("PENDING_PAYMENT")
  // Cancelación con motivo (#108): el cliente pidió que al cancelar se pida una descripción del
  // porqué y que la reserva cancelada se siga viendo en gris en el listado. Nullable porque las
  // cancelaciones que ya existen en la base no tienen motivo y la cancelación desde la web no lo pide.
  cancellationReason String?
  cancelledAt        DateTime?
  cancelledByName    String?
  // Restitución de una reserva cancelada (#117): volver atrás sin borrarla y recargarla con otro
  // código. No se pisa la cancelación —motivo, fecha y quién canceló siguen visibles—; estos dos
  // campos agregan quién y cuándo la restituyó.
  restoredAt         DateTime?
  restoredByName     String?
  totalCents  Int
  currency    String     @default("ARS")
  // Ida y vuelta del aeropuerto (#36): las dos reservas del viaje comparten este id. Cada tramo
  // se paga y se cancela por separado —el id sólo las enlaza y las muestra juntas en el panel—,
  // así que no hay FK: es una agrupación, no una dependencia.
  roundTripId String?
  // Derivación de otra agencia (#109): quién vendió la reserva. Texto libre y opcional porque las
  // agencias no tienen usuario ni rol en la app: lo carga a mano el equipo desde el panel, y sale
  // en la columna «Derivado por» de la orden de servicio del chofer.
  referredBy  String?
  payment     Payment?
  ticket      Ticket?
  chapelcoDetails ChapelcoReservationDetails?
  airportDetails  AirportReservationDetails?
  chapelcoStops ChapelcoManifestStop[]
  // Identidad al momento del alta, conservada aunque cambie o se elimine la cuenta.
  createdByUserId String?
  createdByName   String?
  createdByRole   String?
  createdAt     DateTime  @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([scheduleId, seatNumber])
  @@unique([scheduleId, seatId])
  @@index([code])
  @@index([routeId])
  @@index([bookingMode])
  @@index([roundTripId])
}

model Payment {
  id                  String      @id @default(cuid())
  reservationId       String      @unique
  reservation         Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  provider            String
  status              String      @default("PENDING")
  amountCents         Int
  currency            String      @default("ARS")
  method              String?
  externalRef         String?
  receiptBlobUrl      String?
  receiptBlobPathname String?
  receiptFileName     String?
  receiptContentType  String?
  receiptSize         Int?
  receiptUploadedAt   DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model Ticket {
  id            String      @id @default(cuid())
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  code          String      @unique
  qrPayload     String
  createdAt     DateTime    @default(now())
}

model ChapelcoReservationDetails {
  id              String      @id @default(cuid())
  reservationId   String      @unique
  reservation     Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  serviceDate     DateTime
  ascentSlot      String
  pickupName      String
  pickupAddress   String
  pickupLatitude  Float
  pickupLongitude Float
  pickupNotes     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([serviceDate, ascentSlot])
}

model ChapelcoOperationDay {
  id            String                 @id @default(cuid())
  routeId       String
  route         TravelRoute            @relation(fields: [routeId], references: [id], onDelete: Cascade)
  serviceDate   DateTime
  status        String                 @default("OPEN")
  vehicleDuties ChapelcoVehicleDuty[]
  runs          ChapelcoRun[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([routeId, serviceDate])
  @@index([serviceDate])
}

model ChapelcoVehicleDuty {
  id             String               @id @default(cuid())
  operationDayId String
  operationDay   ChapelcoOperationDay @relation(fields: [operationDayId], references: [id], onDelete: Cascade)
  vehicleId      String
  vehicle        Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId       String?
  driver         User?                @relation(fields: [driverId], references: [id], onDelete: SetNull)
  capacity       Int
  status         String               @default("ACTIVE")
  notes          String?
  runs           ChapelcoRun[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([operationDayId, vehicleId])
  @@index([driverId])
}

model ChapelcoRun {
  id             String                 @id @default(cuid())
  operationDayId String
  operationDay   ChapelcoOperationDay   @relation(fields: [operationDayId], references: [id], onDelete: Cascade)
  vehicleDutyId  String
  vehicleDuty    ChapelcoVehicleDuty    @relation(fields: [vehicleDutyId], references: [id], onDelete: Cascade)
  direction      String
  ascentSlot     String?
  sequence       Int                    @default(1)
  status         String                 @default("PLANNED")
  stops          ChapelcoManifestStop[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([operationDayId, direction, ascentSlot])
  @@index([vehicleDutyId])
}

/// Configuración editable desde el panel. Existe para que una clave que antes vivía sólo en
/// variables de entorno del hosting (y por lo tanto dependía de un tercero para cargarla) se
/// pueda pegar desde el panel. La variable de entorno, si está, tiene prioridad.
model AppSetting {
  key       String   @id
  value     String
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChapelcoManifestStop {
  id              String      @id @default(cuid())
  runId           String
  run             ChapelcoRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  reservationId   String
  reservation     Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  stopOrder       Int
  passengerCount  Int
  pickupName      String
  pickupAddress   String
  pickupLatitude  Float
  pickupLongitude Float
  status          String      @default("PENDING")
  driverNotes     String?
  checkedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([runId, reservationId])
  @@index([reservationId])
  @@index([runId, stopOrder])
}

model SpecialTrip {
  id            String   @id @default(cuid())
  serviceDate   DateTime @db.Date
  client        String
  contact       String?
  passengers    Int?
  status        String
  notes         String?
  legs          Json
  destinationSearch String
  billingMode   String
  currency      String
  totalCents    Int?
  payments      Json
  supplier      String?
  invoice       String?
  invoiceDate   DateTime? @db.Date
  paymentStatus String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  assignments   SpecialTripAssignment[]
  sources       SpecialTripSource[]
  departureSheets DepartureSheet[]

  @@index([serviceDate, status])
}

model SpecialTripAssignment {
  id        String      @id @default(cuid())
  tripId    String
  trip      SpecialTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle     @relation(fields: [vehicleId], references: [id])
  driverId  String?
  driver    User?       @relation(fields: [driverId], references: [id], onDelete: SetNull)
  startsAt  DateTime
  endsAt    DateTime

  @@index([vehicleId, startsAt, endsAt])
  @@index([tripId])
}

model SpecialTripSource {
  id       String      @id
  tripId   String?
  trip     SpecialTrip? @relation(fields: [tripId], references: [id], onDelete: SetNull)
  sheet    String
  row      Int
  original Json
  version  String
  issues   Json

  @@index([tripId])
}

model FleetConflictAcceptance {
  id         String   @id @default(cuid())
  service    String
  serviceId  String
  acceptedBy String
  conflicts  Json
  createdAt  DateTime @default(now())

  @@index([service, serviceId])
}

/// Planilla de salida que el panel le manda al pasajero de una reserva existente: el DUT (salida
/// del país) o el Registro de salida de pasajeros (salida de la provincia).
model DepartureSheet {
  id            String      @id @default(cuid())
  /// "DUT" = salida del país (CNRT) · "PROVINCIA" = salida de la provincia con habilitación puntual.
  kind          String
  /// Capacidad del link público: 128 bits, igual que el código privado de una reserva.
  token         String      @unique
  /// Cerrada = el link sigue mostrando la planilla pero no acepta más pasajeros.
  isOpen        Boolean     @default(true)
  /// Una planilla por viaje especial y por tipo: el link se genera una vez y se reusa.
  specialTripId String
  specialTrip   SpecialTrip @relation(fields: [specialTripId], references: [id], onDelete: Cascade)
  createdBy     String?
  passengers    DepartureSheetPassenger[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([specialTripId, kind])
  @@index([kind])
}

model DepartureSheetPassenger {
  id               String         @id @default(cuid())
  sheetId          String
  sheet            DepartureSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  /// Nº de orden dentro del registro (la columna «Nº» del registro provincial).
  position         Int            @default(0)
  firstName        String
  lastName         String
  documentType     String
  documentNumber   String
  sex              String
  birthDate        DateTime       @db.Date
  nationality      String
  /// Sólo el registro provincial pide ocupación y país de residencia.
  occupation       String?
  residenceCountry String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  /// El mismo documento cargado dos veces actualiza la fila en lugar de duplicarla.
  @@unique([sheetId, documentType, documentNumber])
  @@index([sheetId, position])
}

// Catálogo editorial: no crea reservas ni ocupa naves. Consulta por WhatsApp.
model Excursion {
  id          String   @id @default(cuid())
  name        String
  description String
  duration    String
  priceCents  Int?
  currency    String   @default("ARS")
  isPublished Boolean  @default(false)
  photos      ExcursionPhoto[]
  departures  ExcursionDeparture[]
  bookings    ExcursionBooking[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, name])
}

model ExcursionPhoto {
  id           String    @id @default(cuid())
  excursionId  String
  excursion    Excursion @relation(fields: [excursionId], references: [id], onDelete: Cascade)
  blobPathname String
  contentType  String
  position     Int       @default(0)
  createdAt    DateTime  @default(now())

  @@index([excursionId, position])
}

model ExcursionDeparture {
  id          String    @id @default(cuid())
  excursionId String
  excursion   Excursion @relation(fields: [excursionId], references: [id], onDelete: Cascade)
  departureAt DateTime

  @@unique([excursionId, departureAt])
  @@index([departureAt])
}

/// Venta de una excursión (issue #110). El cliente pidió que la planilla de la excursión tenga la
/// misma forma que la orden de servicio del chofer, con la columna «Derivado por».
model ExcursionBooking {
  id             String    @id @default(cuid())
  /// Mismo formato que las reservas de traslado (`ARC-2611-…`), para buscarla y dictarla.
  code           String    @unique
  shortCode      String    @unique
  excursionId    String
  /// Restrict: borrar una excursión con ventas no debe dejar pasajeros huérfanos.
  excursion      Excursion @relation(fields: [excursionId], references: [id], onDelete: Restrict)
  /// Fecha y hora de la salida vendida.
  departureAt    DateTime
  passengerId    String
  passenger      Passenger @relation(fields: [passengerId], references: [id])
  passengerCount Int       @default(1)
  totalCents     Int       @default(0)
  currency       String    @default("ARS")
  /// `PENDING_PAYMENT` | `CONFIRMED` | `CANCELLED`.
  status         String    @default("PENDING_PAYMENT")
  /// Quién derivó la venta; `null` cuando se vendió directo.
  referredBy     String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([departureAt])
  @@index([excursionId, departureAt])
}
