generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  schoolRuns SchoolRun[]
  id           String    @id @default(cuid())
  email        String    @unique
  googleSub    String?   @unique
  name         String?
  passwordHash String?
  role         String    @default("USER")
  isActive     Boolean   @default(false)
  monthlySalaryCents Int?
  salaryCurrency String @default("ARS")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  driverLocation DriverVehicleLocation?
  driverLocationSamples DriverLocationSample[]
  accountingEntries AccountingEntry[]
  chapelcoDuties ChapelcoVehicleDuty[]
  airportDuties AirportVehicleAssignment[]
  specialTripAssignments SpecialTripAssignment[] @relation("SpecialPrimaryDriver")
  specialTripReliefs SpecialTripAssignment[] @relation("SpecialCoDriver")
  scheduleDuties Schedule[]
  scheduleUnitDuties ScheduleUnit[]
  driverProfile DriverProfile?
}

/// Documentación de un chofer (la planilla «Vencimientos Choferes» del cliente): DNI, licencia de
/// conducir y certificado de antecedentes. Se pide al dar de alta un chofer; los vencimientos se
/// marcan en el listado de choferes. Las fechas son días (medianoche UTC), no instantes.
model DriverProfile {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// DNI, sólo dígitos.
  documentNumber          String
  /// CUIL con guiones (20-12345678-9). Opcional: la planilla lo tiene, el alta no lo exige.
  cuil                    String?
  /// Categoría de la licencia profesional (D1, D2, D3…).
  licenseCategory         String
  /// COMPLETA (nacional) o JURISDICCIONAL.
  licenseScope            String    @default("COMPLETA")
  licenseExpiresAt        DateTime
  /// Certificado de antecedentes provincial.
  criminalRecordExpiresAt DateTime
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([documentNumber])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Auditoría: quién hizo qué y cuándo. Sólo se agregan filas; no hay código que las edite o borre.
/// Sin FK a User a propósito: el actor queda copiado (id, nombre, email y rol del momento) para que
/// borrar una cuenta no se lleve su rastro.
model AuditLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  actorId     String?
  actorName   String?
  actorEmail  String?
  // Rol al momento del hecho: ADMIN, SECRETARY, DRIVER, USER, GUEST (sin sesión) o SYSTEM.
  actorRole   String   @default("SYSTEM")
  action      String
  entity      String
  entityId    String?
  // Cómo se nombra el registro en pantalla: código de reserva, email de la cuenta, etc.
  entityLabel String?
  summary     String
  // Sólo los campos que cambiaron: { campo: { before, after } }. Nunca contraseñas ni tokens.
  changes     Json?
  ip          String?
  userAgent   String?

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
}

model TravelRoute {
  id          String     @id @default(cuid())
  slug        String     @unique
  from        String
  to          String
  via         String
  durationMin Int
  priceCents  Int
  currency    String     @default("ARS")
  category    String
  description String
  featured    Boolean    @default(false)
  isActive    Boolean    @default(true)
  bookingMode String     @default("SEATED")
  specialType String?
  serviceStartDate DateTime?
  serviceEndDate   DateTime?
  stops       Json
  schedules   Schedule[]
  directReservations Reservation[]
  chapelcoOperationDays ChapelcoOperationDay[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Vehicle {
  schoolRuns SchoolRun[]
  id           String     @id @default(cuid())
  name         String
  brand        String     @default("Araucana")
  model        String     @default("Operativo")
  licensePlate String?
  templateKey  String?
  layoutMarkers Json       @default("[]")
  isActive     Boolean    @default(true)
  // ── Ficha de la unidad (planilla de flota del cliente) ──────────────────────
  /** Número de interno con el que la empresa identifica la unidad ("1910", "243", "152"). */
  internalNumber String?
  /** Titular registral: LA ARAUCANA VIAJES SRL, TROMPUL S.R.L., PRIETO JUAN CARLOS. */
  owner        String?
  year         Int?
  acquiredAt   DateTime?
  /** Vencimiento de la revisión técnica (VTV). */
  technicalInspectionDueAt DateTime?
  /** Vencimiento del RTO nacional. */
  rtoDueAt     DateTime?
  insurer      String?
  policyDueAt  DateTime?
  /// Cobertura adicional para servicio público cuando la unidad conserva otra póliza vigente.
  secondaryPolicyDueAt DateTime?
  /**
   * Habilita la unidad para "transporte público" (los tramos que vende la web).
   * En la planilla del cliente son las aseguradas por **Prot Mut**: los buses grandes.
   */
  publicTransport Boolean @default(false)
  /** CAMIONETA · BUS · UTILITARIO (los utilitarios no se asignan a salidas). */
  kind         String     @default("CAMIONETA")
  notes        String?
  seats        Seat[]
  schedules    Schedule[]
  scheduleUnits ScheduleUnit[]
  driverLocations DriverVehicleLocation[]
  driverLocationSamples DriverLocationSample[]
  accountingEntries AccountingEntry[]
  chapelcoDuties ChapelcoVehicleDuty[]
  airportAssignments AirportVehicleAssignment[]
  specialTripAssignments SpecialTripAssignment[]
  damages      VehicleDamage[]
  serviceSheets VehicleServiceSheet[]
  documents    VehicleDocument[]
  /** Cada cuántos km corresponde un service; null = la unidad no tiene intervalo definido. */
  serviceIntervalKm Int?
  odometerReadings VehicleOdometerReading[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt @default(now())

  @@index([internalNumber])
  @@index([licensePlate])
}

model AccountingEntry {
  id           String   @id @default(cuid())
  category     String
  amountCents  Int
  currency     String   @default("ARS")
  occurredAt   DateTime
  vehicleId    String?
  vehicle      Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  salaryPeriod String?
  notes        String?
  /// Daños que se dieron por reparados con este arreglo (ficha de la nave → Reparaciones).
  repairedDamages VehicleDamage[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([occurredAt])
  @@index([category])
  @@index([vehicleId])
  @@index([userId])
  @@index([salaryPeriod])
}

/// Un daño de una nave (choque, rotura, falla): se anota desde la ficha de la unidad y queda
/// pendiente hasta que se repara. El arreglo es un egreso de contabilidad (categoría REPAIR).
model VehicleDamage {
  id            String           @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  occurredAt    DateTime
  description   String
  /// LEVE · MODERADO · GRAVE (grave = la unidad no debería salir hasta repararla).
  severity      String           @default("LEVE")
  /// PENDIENTE · EN_REPARACION · REPARADO
  status        String           @default("PENDIENTE")
  repairedAt    DateTime?
  repairEntryId String?
  repairEntry   AccountingEntry? @relation(fields: [repairEntryId], references: [id], onDelete: SetNull)
  reportedBy    String?
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([vehicleId, occurredAt])
  @@index([repairEntryId])
}

model DriverVehicleLocation {
  id         String   @id @default(cuid())
  driverId   String   @unique
  driver     User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  latitude   Float
  longitude  Float
  accuracy   Float?
  heading    Float?
  speed      Float?
  altitude   Float?
  altitudeAccuracy Float?
  batteryLevel Float?
  batteryCharging Boolean?
  clientNetworkType String?
  distanceFromPreviousMeters Float?
  secondsFromPrevious Float?
  reportedSpeedKmh Float?
  inferredSpeedKmh Float?
  isStopped Boolean @default(false)
  stoppedDurationSeconds Float @default(0)
  stopStartedAt DateTime?
  recordedAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([vehicleId])
  @@index([recordedAt])
}

model DriverLocationSample {
  id         String   @id @default(cuid())
  driverId   String
  driver     User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  latitude   Float
  longitude  Float
  accuracy   Float?
  heading    Float?
  speed      Float?
  altitude   Float?
  altitudeAccuracy Float?
  batteryLevel Float?
  batteryCharging Boolean?
  clientNetworkType String?
  distanceFromPreviousMeters Float?
  secondsFromPrevious Float?
  reportedSpeedKmh Float?
  inferredSpeedKmh Float?
  isStopped Boolean @default(false)
  stoppedDurationSeconds Float @default(0)
  stopStartedAt DateTime?
  recordedAt DateTime
  createdAt  DateTime @default(now())

  @@index([driverId, recordedAt])
  @@index([vehicleId, recordedAt])
  @@index([isStopped])
}

model Flight {
  id            String        @id @default(cuid())
  number        String
  airline       String?
  origin        String
  destination   String        @default("Aeropuerto Chapelco (CPC)")
  direction     String        @default("ARRIVAL")
  scheduledAt   DateTime
  estimatedAt   DateTime?
  pickupStartOverrideAt DateTime?
  /// Vuelos del mismo día y sentido que hace una sola camioneta en la misma vuelta («Coordinar
  /// recorrida» / «Juntar arribos»). Comparten este id y la hoja del chofer los une en una orden.
  pickupGroupId         String?
  actualAt      DateTime?
  status        String        @default("SCHEDULED")
  passengers    Int?
  source        String        @default("MANUAL")
  externalId    String?
  lastCheckedAt DateTime?
  notes         String?
  createdBy     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  events        FlightEvent[]
  reservations  AirportReservationDetails[]
  assignments   AirportVehicleAssignment[]
  observations  FlightObservation[]

  @@unique([number, scheduledAt, direction])
  @@index([scheduledAt])
  @@index([status])
  @@index([pickupGroupId])
}

/// Lo que dijo cada fuente (AirLabs, tablero del aeropuerto) en cada sincronización, tal como vino.
/// Modo sombra: no decide nada sobre `Flight`. Sirve para comparar fuentes y medir duplicados antes
/// de que el asociador pase a decidir qué fila es cada vuelo. Ver docs/aeropuerto-vuelos.md.
model FlightObservation {
  id              String    @id @default(cuid())
  syncRunId       String
  source          String
  observedAt      DateTime  @default(now())
  direction       String
  rawNumber       String
  canonicalNumber String
  airline         String?
  codeshareOf     String?
  origin          String?
  scheduledAt     DateTime?
  estimatedAt     DateTime?
  status          String?
  rawStatus       String?
  localDay        String?
  dayInferred     Boolean   @default(false)
  matchKey        String?
  /// Qué hizo el sync con esta lectura (ACTUALIZADO, CREADO, DESCARTADO_GEMELO, …).
  syncOutcome     String
  /// Fila a la que el sync aplicó la lectura. SetNull: el sync borra filas repetidas todo el tiempo.
  flightId        String?
  flight          Flight?   @relation(fields: [flightId], references: [id], onDelete: SetNull)
  /// Fila que habría elegido el asociador por identidad de vuelo (sombra, sin FK).
  matcherFlightId String?
  matchLevel      String
  discrepancy     String?
  payload         Json?

  @@index([syncRunId])
  @@index([localDay, direction])
  @@index([matchKey])
  @@index([flightId])
}

model FlightEvent {
  id         String    @id @default(cuid())
  flightId   String
  flight     Flight    @relation(fields: [flightId], references: [id], onDelete: Cascade)
  kind       String
  fromValue  String?
  toValue    String?
  detectedAt DateTime  @default(now())
  notifiedAt DateTime?

  @@index([flightId, detectedAt])
}

model AirportReservationDetails {
  id            String      @id @default(cuid())
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  flightNumber  String
  flightId      String?
  flight        Flight?     @relation(fields: [flightId], references: [id], onDelete: SetNull)
  direction     String
  serviceDate   DateTime
  pickupName    String?
  pickupAddress String?
  pickupLatitude Float?
  pickupLongitude Float?
  pickupNotes   String?
  halfFareCount Int         @default(0)
  /// Bultos de equipaje deportivo y precio unitario vigente al reservar.
  sportsLuggageCount     Int @default(0)
  sportsLuggageUnitCents Int @default(0)
  /// Recargo por zona (segundo límite del mapa) cobrado al reservar.
  zoneExtraCents         Int @default(0)
  paihuenUnitCents       Int @default(0)
  /// Nave en la que va el pasajero cuando el vuelo tiene más de una (orden de servicio por nave).
  /// `null` = la reparte la orden según la capacidad. Se ignora si la asignación es de otro vuelo.
  assignmentId  String?
  assignment    AirportVehicleAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  /// Lugar en la recorrida, ordenado a mano desde la orden de servicio. `null` = orden sugerido.
  routePosition Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([serviceDate, direction])
  @@index([flightNumber])
  @@index([assignmentId])
}

model AirportVehicleAssignment {
  id        String   @id @default(cuid())
  flightId  String
  flight    Flight   @relation(fields: [flightId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId  String?
  driver    User?    @relation(fields: [driverId], references: [id], onDelete: SetNull)
  notes     String?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  passengers AirportReservationDetails[]

  @@unique([flightId, vehicleId])
  @@index([flightId])
}

model Seat {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  number    String
  row       Int
  column    Int
  createdAt DateTime @default(now())
  reservations Reservation[]

  @@unique([vehicleId, number])
}

model Schedule {
  id           String        @id @default(cuid())
  routeId      String
  route        TravelRoute   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  vehicleId    String
  vehicle      Vehicle       @relation(fields: [vehicleId], references: [id])
  /// Chofer de la salida (issue #174): se asigna desde «Salidas del día», igual que en aeropuerto,
  /// Chapelco y viajes especiales. Opcional: las salidas existentes quedan sin chofer.
  driverId     String?
  driver       User?         @relation(fields: [driverId], references: [id], onDelete: SetNull)
  departureAt  DateTime
  arrivalAt    DateTime
  status       String        @default("OPEN")
  reservations Reservation[]
  /// Naves que se suman a la salida además de la principal (`vehicleId`). El cupo de la salida es
  /// la suma de los asientos de todas sus naves.
  extraUnits   ScheduleUnit[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([routeId, departureAt])
  @@index([driverId])
}

/// Una nave más en una salida de ruta, con su chofer. La primera nave sigue en `Schedule.vehicleId`
/// (y su chofer en `Schedule.driverId`); acá van la segunda, la tercera… Una misma nave no se repite
/// en la salida.
model ScheduleUnit {
  id         String   @id @default(cuid())
  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  driverId   String?
  driver     User?    @relation(fields: [driverId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@unique([scheduleId, vehicleId])
  @@index([vehicleId])
  @@index([driverId])
}

model Passenger {
  id           String        @id @default(cuid())
  firstName    String
  lastName     String
  email        String
  phone        String
  documentType String
  documentId   String
  nationality  String?
  reservations Reservation[]
  excursionBookings ExcursionBooking[]
  createdAt    DateTime      @default(now())
}

/// Contador de pedidos por IP y ventana de tiempo: el freno contra ráfagas de reservas.
model RateLimitHit {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}

model Reservation {
  id          String     @id @default(cuid())
  code        String     @unique
  // Código corto para dictar, imprimir y buscar en el panel (issue #75). No es una capability:
  // la reserva se abre sólo con `code`, y este código lo resuelve el buscador con sesión de staff.
  shortCode   String     @unique
  // Idempotencia del alta (#139): la clave la genera el formulario y el servidor la usa para
  // devolver la reserva ya creada en vez de crear otra cuando el pasajero reintenta (se le cortó
  // la red, apretó dos veces, recargó). Nullable: las reservas históricas y las altas sin clave
  // no la tienen, y un índice único acepta varios NULL. En el ida y vuelta cada tramo lleva la
  // misma clave con su sentido de sufijo (`<clave>:arrival` / `<clave>:departure`), porque el
  // viaje se crea en una sola transacción y sus dos reservas son filas distintas.
  idempotencyKey String? @unique
  scheduleId  String?
  // Restrict a propósito: la base real ya lo tiene así y no queremos que borrar una salida
  // con reservas deje huérfanas a las reservas (el esquema declaraba SetNull por deriva vieja).
  schedule    Schedule?  @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  routeId     String?
  route       TravelRoute? @relation(fields: [routeId], references: [id], onDelete: SetNull)
  passengerId String
  passenger   Passenger  @relation(fields: [passengerId], references: [id])
  seatId      String?
  seat        Seat?      @relation(fields: [seatId], references: [id], onDelete: Restrict)
  seatNumber  String?
  boardingStop String?
  dropoffStop String?
  passengerCount Int     @default(1)
  // Tarifas por edad (issue #33): los pasajeros vienen dentro de passengerCount, que es el total
  // que ocupa lugar. `halfFareCount` son los menores de 4 a 8 años y `freeFareCount` los menores de 4.
  halfFareCount Int      @default(0)
  freeFareCount Int      @default(0)
  bookingMode String     @default("SEATED")
  status      String     @default("PENDING_PAYMENT")
  // Cancelación con motivo (#108): el cliente pidió que al cancelar se pida una descripción del
  // porqué y que la reserva cancelada se siga viendo en gris en el listado. Nullable porque las
  // cancelaciones que ya existen en la base no tienen motivo y la cancelación desde la web no lo pide.
  cancellationReason String?
  cancelledAt        DateTime?
  cancelledByName    String?
  // Restitución de una reserva cancelada (#117): volver atrás sin borrarla y recargarla con otro
  // código. No se pisa la cancelación —motivo, fecha y quién canceló siguen visibles—; estos dos
  // campos agregan quién y cuándo la restituyó.
  restoredAt         DateTime?
  restoredByName     String?
  totalCents  Int
  currency    String     @default("ARS")
  // Ida y vuelta del aeropuerto (#36): las dos reservas del viaje comparten este id. Cada tramo
  // se paga y se cancela por separado —el id sólo las enlaza y las muestra juntas en el panel—,
  // así que no hay FK: es una agrupación, no una dependencia.
  roundTripId String?
  // Derivación de otra agencia (#109): quién vendió la reserva. Texto libre y opcional porque las
  // agencias no tienen usuario ni rol en la app: lo carga a mano el equipo desde el panel, y sale
  // en la columna «Derivado por» de la orden de servicio del chofer.
  referredBy  String?
  payment     Payment?
  ticket      Ticket?
  serviceTicket ServiceTicket?
  chapelcoDetails ChapelcoReservationDetails?
  airportDetails  AirportReservationDetails?
  chapelcoStops ChapelcoManifestStop[]
  // Identidad al momento del alta, conservada aunque cambie o se elimine la cuenta.
  createdByUserId String?
  createdByName   String?
  createdByRole   String?
  createdAt     DateTime  @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([scheduleId, seatNumber])
  @@unique([scheduleId, seatId])
  @@index([code])
  @@index([routeId])
  @@index([bookingMode])
  @@index([roundTripId])
}

model Payment {
  id                  String      @id @default(cuid())
  reservationId       String      @unique
  reservation         Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  provider            String
  status              String      @default("PENDING")
  amountCents         Int
  currency            String      @default("ARS")
  method              String?
  externalRef         String?
  receiptBlobUrl      String?
  receiptBlobPathname String?
  receiptFileName     String?
  receiptContentType  String?
  receiptSize         Int?
  receiptUploadedAt   DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model Ticket {
  id            String      @id @default(cuid())
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  code          String      @unique
  qrPayload     String
  createdAt     DateTime    @default(now())
}

/// Contador de la numeración correlativa (issue #370). Una fila por serie: `W` = web.
/// El número se consume al emitir, no al cobrar, y nunca se reinicia ni se reutiliza.
model TicketSeries {
  id         String          @id @default(cuid())
  series     String          @unique
  nextNumber Int             @default(1)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  tickets    ServiceTicket[]
}

/// Boleto del servicio público, numerado y correlativo (issue #370). Distinto de `Ticket`,
/// que es el QR de control de una reserva: éste es el comprobante que se muestra y se rinde.
model ServiceTicket {
  id            String       @id @default(cuid())
  series        String
  number        Int
  /// Número tal como se lee y se imprime: `W001`.
  displayNumber String
  seriesId      String
  seriesRow     TicketSeries @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  reservationId String       @unique
  /// `Restrict` a propósito (#381): borrar la reserva no puede llevarse el número emitido.
  reservation   Reservation  @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  /// EMITIDO | ANULADO
  status        String       @default("EMITIDO")
  issuedAt      DateTime     @default(now())
  issuedById    String?
  issuedByName  String?
  origin        String
  destination   String
  serviceDate   DateTime
  departureAt   DateTime?
  fareCents     Int
  currency      String       @default("ARS")
  paymentMethod String?
  annulledAt    DateTime?
  annulledById  String?
  annulledByName String?
  annulReason   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([series, number])
  @@index([status])
  @@index([displayNumber])
}

model ChapelcoReservationDetails {
  id              String      @id @default(cuid())
  reservationId   String      @unique
  reservation     Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  serviceDate     DateTime
  ascentSlot      String
  pickupName      String
  pickupAddress   String
  pickupLatitude  Float
  pickupLongitude Float
  pickupNotes     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([serviceDate, ascentSlot])
}

model ChapelcoOperationDay {
  id            String                 @id @default(cuid())
  routeId       String
  route         TravelRoute            @relation(fields: [routeId], references: [id], onDelete: Cascade)
  serviceDate   DateTime
  status        String                 @default("OPEN")
  vehicleDuties ChapelcoVehicleDuty[]
  runs          ChapelcoRun[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([routeId, serviceDate])
  @@index([serviceDate])
}

model ChapelcoVehicleDuty {
  id             String               @id @default(cuid())
  operationDayId String
  operationDay   ChapelcoOperationDay @relation(fields: [operationDayId], references: [id], onDelete: Cascade)
  vehicleId      String
  vehicle        Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId       String?
  driver         User?                @relation(fields: [driverId], references: [id], onDelete: SetNull)
  capacity       Int
  status         String               @default("ACTIVE")
  notes          String?
  runs           ChapelcoRun[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([operationDayId, vehicleId])
  @@index([driverId])
}

model ChapelcoRun {
  id             String                 @id @default(cuid())
  operationDayId String
  operationDay   ChapelcoOperationDay   @relation(fields: [operationDayId], references: [id], onDelete: Cascade)
  vehicleDutyId  String
  vehicleDuty    ChapelcoVehicleDuty    @relation(fields: [vehicleDutyId], references: [id], onDelete: Cascade)
  direction      String
  ascentSlot     String?
  sequence       Int                    @default(1)
  status         String                 @default("PLANNED")
  stops          ChapelcoManifestStop[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([operationDayId, direction, ascentSlot])
  @@index([vehicleDutyId])
}

/// Configuración editable desde el panel. Existe para que una clave que antes vivía sólo en
/// variables de entorno del hosting (y por lo tanto dependía de un tercero para cargarla) se
/// pueda pegar desde el panel. La variable de entorno, si está, tiene prioridad.
model AppSetting {
  key       String   @id
  value     String
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChapelcoManifestStop {
  id              String      @id @default(cuid())
  runId           String
  run             ChapelcoRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  reservationId   String
  reservation     Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  stopOrder       Int
  passengerCount  Int
  pickupName      String
  pickupAddress   String
  pickupLatitude  Float
  pickupLongitude Float
  status          String      @default("PENDING")
  driverNotes     String?
  checkedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([runId, reservationId])
  @@index([reservationId])
  @@index([runId, stopOrder])
}

model SpecialTrip {
  id            String   @id @default(cuid())
  /** Día en que sale el viaje. */
  serviceDate   DateTime @db.Date
  /**
   * Día en que vuelve, para los viajes de varios días («del 20 al 26»): el viaje figura en cada día del
   * rango. Vacío = viaje de un día, como todos los que se cargaron antes de esta columna.
   */
  endDate       DateTime? @db.Date
  client        String
  contact       String?
  contactName   String?
  contactPhone  String?
  passengers    Int?
  status        String
  notes         String?
  legs          Json
  destinationSearch String
  billingMode   String
  currency      String
  totalCents    Int?
  payments      Json
  supplier      String?
  invoice       String?
  invoiceDate   DateTime? @db.Date
  paymentStatus String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  assignments   SpecialTripAssignment[]
  sources       SpecialTripSource[]
  departureSheets DepartureSheet[]

  @@index([serviceDate, status])
  @@index([endDate])
}

model SpecialTripAssignment {
  id        String      @id @default(cuid())
  tripId    String
  trip      SpecialTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle     @relation(fields: [vehicleId], references: [id])
  driverId  String?
  driver    User?       @relation("SpecialPrimaryDriver", fields: [driverId], references: [id], onDelete: SetNull)
  coDriverId String?
  coDriver User? @relation("SpecialCoDriver", fields: [coDriverId], references: [id], onDelete: SetNull)
  startsAt  DateTime
  endsAt    DateTime

  @@index([vehicleId, startsAt, endsAt])
  @@index([tripId])
}

model SpecialTripSource {
  id       String      @id
  tripId   String?
  trip     SpecialTrip? @relation(fields: [tripId], references: [id], onDelete: SetNull)
  sheet    String
  row      Int
  original Json
  version  String
  issues   Json

  @@index([tripId])
}

model FleetConflictAcceptance {
  id         String   @id @default(cuid())
  service    String
  serviceId  String
  acceptedBy String
  conflicts  Json
  createdAt  DateTime @default(now())

  @@index([service, serviceId])
}

/// Planilla de salida que el panel le manda al pasajero de una reserva existente: el DUT (salida
/// del país) o el Registro de salida de pasajeros (salida de la provincia).
model DepartureSheet {
  id            String      @id @default(cuid())
  /// "DUT" = salida del país (CNRT) · "PROVINCIA" = salida de la provincia con habilitación puntual.
  kind          String
  /// Capacidad del link público: 128 bits, igual que el código privado de una reserva.
  token         String      @unique
  /// Cerrada = el link sigue mostrando la planilla pero no acepta más pasajeros.
  isOpen        Boolean     @default(true)
  /// Una planilla por viaje especial y por tipo: el link se genera una vez y se reusa.
  specialTripId String
  specialTrip   SpecialTrip @relation(fields: [specialTripId], references: [id], onDelete: Cascade)
  createdBy     String?
  passengers    DepartureSheetPassenger[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([specialTripId, kind])
  @@index([kind])
}

model DepartureSheetPassenger {
  id               String         @id @default(cuid())
  sheetId          String
  sheet            DepartureSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  /// Nº de orden dentro del registro (la columna «Nº» del registro provincial).
  position         Int            @default(0)
  firstName        String
  lastName         String
  documentType     String
  documentNumber   String
  sex              String
  birthDate        DateTime       @db.Date
  nationality      String
  /// Sólo el registro provincial pide ocupación y país de residencia.
  occupation       String?
  residenceCountry String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  /// El mismo documento cargado dos veces actualiza la fila en lugar de duplicarla.
  @@unique([sheetId, documentType, documentNumber])
  @@index([sheetId, position])
}

// Catálogo editorial: no crea reservas ni ocupa naves. Consulta por WhatsApp.
model Excursion {
  id          String   @id @default(cuid())
  name        String
  description String
  duration    String
  priceCents  Int?
  currency    String   @default("ARS")
  isPublished Boolean  @default(false)
  photos      ExcursionPhoto[]
  departures  ExcursionDeparture[]
  bookings    ExcursionBooking[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, name])
}

model ExcursionPhoto {
  id           String    @id @default(cuid())
  excursionId  String
  excursion    Excursion @relation(fields: [excursionId], references: [id], onDelete: Cascade)
  blobPathname String
  contentType  String
  position     Int       @default(0)
  createdAt    DateTime  @default(now())

  @@index([excursionId, position])
}

model ExcursionDeparture {
  id          String    @id @default(cuid())
  excursionId String
  excursion   Excursion @relation(fields: [excursionId], references: [id], onDelete: Cascade)
  departureAt DateTime

  @@unique([excursionId, departureAt])
  @@index([departureAt])
}

/// Venta de una excursión (issue #110). El cliente pidió que la planilla de la excursión tenga la
/// misma forma que la orden de servicio del chofer, con la columna «Derivado por».
model ExcursionBooking {
  id             String    @id @default(cuid())
  /// Mismo formato que las reservas de traslado (`ARC-2611-…`), para buscarla y dictarla.
  code           String    @unique
  shortCode      String    @unique
  excursionId    String
  /// Restrict: borrar una excursión con ventas no debe dejar pasajeros huérfanos.
  excursion      Excursion @relation(fields: [excursionId], references: [id], onDelete: Restrict)
  /// Fecha y hora de la salida vendida.
  departureAt    DateTime
  passengerId    String
  passenger      Passenger @relation(fields: [passengerId], references: [id])
  passengerCount Int       @default(1)
  totalCents     Int       @default(0)
  currency       String    @default("ARS")
  /// `PENDING_PAYMENT` | `CONFIRMED` | `CANCELLED`.
  status         String    @default("PENDING_PAYMENT")
  /// Quién derivó la venta; `null` cuando se vendió directo.
  referredBy     String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([departureAt])
  @@index([excursionId, departureAt])
}

/// Planilla de service de una nave: la que hoy el taller llena en papel. `checks` guarda
/// { <id del ítem>: "OK" | "FALLA" | "NA" } sobre el catálogo de src/lib/vehicles/service-sheet.ts.
model VehicleServiceSheet {
  id         String   @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  /// Día del service, a medianoche UTC (igual que los días de Chapelco).
  servicedAt DateTime
  odometerKm Int
  checks     Json     @default("{}")
  /// Qué se le hizo: aceite, filtros, frenos, cubiertas.
  workDone   String?
  notes      String?
  reportedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt @default(now())

  @@index([vehicleId, servicedAt])
}

/// La documentación de una unidad: póliza, técnica, RTO y cédula. Cada subida es una fila y el
/// vigente de cada tipo es la última: reemplazar un papel deja el anterior como historial.
model VehicleDocument {
  id             String   @id @default(cuid())
  vehicleId      String
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  /// POLIZA · TECNICA · RTO · CEDULA
  kind           String
  fileName       String
  contentType    String
  sizeBytes      Int
  blobUrl        String
  blobPathname   String
  /// Vencimiento que declara el papel subido (opcional). Las fechas oficiales siguen en Vehicle.
  expiresAt      DateTime?
  /// Quién lo subió, copiado: borrar la cuenta no se lleva el rastro.
  uploadedById   String?
  uploadedByName String?
  createdAt      DateTime @default(now())

  @@index([vehicleId, kind, createdAt])
}

/// Un servicio escolar fechado. Las filas paralelas pueden tener el mismo recorrido.
model SchoolRun {
  id           String   @id @default(cuid())
  serviceDate  DateTime @db.Date
  /// escuela · personal-aeropuerto · otro: los servicios recurrentes que agrupa Concesiones.
  kind         String   @default("escuela")
  routeName    String
  shift        String
  driverId     String?
  driver       User?    @relation(fields: [driverId], references: [id], onDelete: SetNull)
  vehicleId    String?
  vehicle      Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  companion    String?
  notes        String?
  review       String?
  source       Json?
  revision     Int      @default(0)
  @@index([serviceDate, routeName])
}

/// Última jornada comunicada manualmente a un chofer.
model DriverPlanNotice {
  serviceDate DateTime @db.Date
  driverId    String
  fingerprint String
  notifiedAt  DateTime @default(now())
  notifiedBy  String

  @@id([serviceDate, driverId])
}

/// Lectura de kilometraje de una unidad, entre services. Quique las anota cuando carga en YPF en ruta
/// (#369): el service sabe el km con el que se hizo, esto dice cuánto se recorrió desde entonces.
model VehicleOdometerReading {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  km        Int
  readAt    DateTime @default(now())
  /// PANEL · CHOFER · SERVICE
  source    String   @default("PANEL")
  createdBy String?
  createdAt DateTime @default(now())

  @@index([vehicleId, readAt])
}
