DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Base PostgreSQL local separada, usada únicamente por npm run prisma:seed.
DEMO_DATABASE_URL=""
AUTH_JWT_SECRET="generate-a-random-secret-with-at-least-32-bytes"
AUTH_BOOTSTRAP_TOKEN="one-time-secret-to-initialize-an-existing-admin"
AUTH_BASE_URL="https://araucana.vercel.app"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Opcional: clave web restringida a Maps Embed API y a los dominios de Araucana.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=""
# Buscador de traslados: clave web para Maps JavaScript API y Places API (New), y mapa de tipo JavaScript.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""
# Endpoint privado de búsqueda compatible con Nominatim (por ejemplo, LocationIQ).
AIRPORT_GEOCODER_URL=""
AIRPORT_GEOCODER_KEY=""
# Opcional: endpoint de una instancia Photon para el autocompletado alternativo.
AIRPORT_PHOTON_URL=""
SESSION_DAYS="30"
